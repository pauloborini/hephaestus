{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hephaestus Project State",
  "description": "Versioned project state: .app-work/hephaestus-state.json (lowercase name, D7). Four blocks (D29): meta read by preflight; routing by preflight and route; answers by route and interview; shield by route and compose. meta.adoptionStatus separates saved answers from applied/validated adoption. this-run answers live only in the ephemeral run-answers.json manifest. No metrics — telemetry lives in .hephaestus/, never here. A top-level field the schema does not know is ignored and what is needed is re-asked, never migrated (D4).",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packVersion": {
          "type": "string",
          "minLength": 1
        },
        "schemaVersion": {
          "type": "string",
          "minLength": 1
        },
        "lastRunAt": {
          "type": "string",
          "minLength": 1
        },
        "lastRunId": {
          "type": "string",
          "minLength": 1
        },
        "adoptionStatus": {
          "type": "string",
          "enum": ["pending", "applied", "validated"]
        },
        "adoptionRunId": {
          "type": "string",
          "minLength": 1
        },
        "adoptionUpdatedAt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overlay": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/catalogEntry"
          }
        },
        "forbiddenPatterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "answers": {
      "type": "object",
      "description": "questionKey map (sha256 of the normalized context) -> human project-scope answer (D22). Stable keys: they derive from context, never from the question text.",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-f0-9]{64}$": {
          "$ref": "#/$defs/answer"
        }
      }
    },
    "shield": {
      "type": "array",
      "description": "Opt-in shielding of third-party content (D9): path + section selector. Empty by default — all content is reabsorbed until declared.",
      "default": [],
      "items": {
        "$ref": "#/$defs/shieldEntry"
      }
    }
  },
  "$defs": {
    "catalogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "destination", "confidence"],
      "properties": {
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "destination": {
          "type": ["string", "null"]
        },
        "confidence": {
          "type": "string",
          "enum": ["alta", "baixa"]
        },
        "since": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answer", "scope", "sourceEvidence"],
      "properties": {
        "answer": {
          "type": "object",
          "description": "Structured answer (shape varies by question type; for a destination question, carries destinationPath)."
        },
        "contextFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Hash of the material context that makes the answer valid; absence identifies a legacy non-reusable answer."
        },
        "scope": {
          "type": "string",
          "enum": ["this-project", "promote-to-catalog"]
        },
        "sourceEvidence": {
          "type": "string",
          "minLength": 1
        },
        "answeredAt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "shieldEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "selector": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
