{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hephaestus Run State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "status",
    "currentPhase",
    "phaseStates",
    "artifactsWritten",
    "lastUpdatedAt"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["running", "interrupted", "blocked", "completed"]
    },
    "currentPhase": {
      "type": "string",
      "enum": [
        "preflight",
        "discover",
        "snapshot",
        "fragment",
        "route",
        "reconcile",
        "interview",
        "plan",
        "compose",
        "verify_staging",
        "apply",
        "verify_applied",
        "closeout"
      ]
    },
    "mode": {
      "type": "string",
      "enum": ["adopt", "maintain"]
    },
    "llmDecidedRatio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "phaseStates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preflight",
        "discover",
        "snapshot",
        "fragment",
        "route",
        "reconcile",
        "interview",
        "plan",
        "compose",
        "verify_staging",
        "apply",
        "verify_applied",
        "closeout"
      ],
      "properties": {
        "preflight": { "$ref": "#/$defs/phaseState" },
        "discover": { "$ref": "#/$defs/phaseState" },
        "snapshot": { "$ref": "#/$defs/phaseState" },
        "fragment": { "$ref": "#/$defs/phaseState" },
        "route": { "$ref": "#/$defs/phaseState" },
        "reconcile": { "$ref": "#/$defs/phaseState" },
        "interview": { "$ref": "#/$defs/phaseState" },
        "plan": { "$ref": "#/$defs/phaseState" },
        "compose": { "$ref": "#/$defs/phaseState" },
        "verify_staging": { "$ref": "#/$defs/phaseState" },
        "apply": { "$ref": "#/$defs/phaseState" },
        "verify_applied": { "$ref": "#/$defs/phaseState" },
        "closeout": { "$ref": "#/$defs/phaseState" }
      }
    },
    "artifactsWritten": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactState"
      }
    },
    "pendingActions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lastUpdatedAt": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "phaseState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not_started", "in_progress", "produced", "validated", "failed"]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "artifactState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputPath", "phase", "validationStatus"],
      "properties": {
        "outputPath": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": "string",
          "enum": [
            "preflight",
            "discover",
            "snapshot",
            "fragment",
            "route",
            "reconcile",
            "interview",
            "plan",
            "compose",
            "verify_staging",
            "apply",
            "verify_applied",
            "closeout"
          ]
        },
        "validationStatus": {
          "type": "string",
          "enum": ["valid", "degraded", "blocked", "unknown"]
        }
      }
    }
  }
}
