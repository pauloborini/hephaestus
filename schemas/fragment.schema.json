{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hephaestus Fragment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fragmentId",
    "rawText",
    "territory",
    "regime",
    "confidence",
    "ambiguity",
    "provenance"
  ],
  "properties": {
    "fragmentId": {
      "type": "string",
      "minLength": 1
    },
    "rawText": {
      "type": "string",
      "minLength": 1
    },
    "territory": {
      "type": "string",
      "enum": ["agents", "project-rules", "vault", "process"]
    },
    "regime": {
      "type": "string",
      "enum": ["keep", "generate", "reconcile", "relocate", "delete", "condense"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "ambiguity": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "structuralType": {
      "type": "string",
      "enum": ["seção", "regra", "checklist", "exemplo", "tabela", "preferência", "metadado", "desconhecido"]
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourcePath", "startOffset", "endOffset"],
        "properties": {
          "sourcePath": {
            "type": "string",
            "minLength": 1
          },
          "startOffset": {
            "type": "integer",
            "minimum": 0
          },
          "endOffset": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
