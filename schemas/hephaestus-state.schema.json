{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hephaestus Project State",
  "description": "Estado versionado do projeto: .app-work/hephaestus-state.json (nome em minúsculo, D7). Quatro blocos (D29): meta lido por preflight; routing por preflight e route; answers por route e interview; shield por route e compose. meta.adoptionStatus separa respostas salvas de adoção aplicada/validada. Respostas this-run vivem somente no manifest efêmero run-answers.json. Sem métricas — telemetria vive em .hephaestus/, nunca aqui. Campo de topo que o schema não conhece é ignorado e o necessário reperguntado, nunca migrado (D4).",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packVersion": {
          "type": "string",
          "minLength": 1
        },
        "schemaVersion": {
          "type": "string",
          "minLength": 1
        },
        "lastRunAt": {
          "type": "string",
          "minLength": 1
        },
        "lastRunId": {
          "type": "string",
          "minLength": 1
        },
        "adoptionStatus": {
          "type": "string",
          "enum": ["pending", "applied", "validated"]
        },
        "adoptionRunId": {
          "type": "string",
          "minLength": 1
        },
        "adoptionUpdatedAt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overlay": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/catalogEntry"
          }
        },
        "forbiddenPatterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "answers": {
      "type": "object",
      "description": "Mapa questionKey (sha256 do contexto normalizado) -> resposta humana de escopo do projeto (D22). Chaves estáveis: derivam do contexto, nunca do texto da pergunta.",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-f0-9]{64}$": {
          "$ref": "#/$defs/answer"
        }
      }
    },
    "shield": {
      "type": "array",
      "description": "Blindagem opt-in de conteúdo de terceiros (D9): path + seletor de seção. Vazia por default — todo conteúdo é reabsorvido até ser declarado.",
      "default": [],
      "items": {
        "$ref": "#/$defs/shieldEntry"
      }
    }
  },
  "$defs": {
    "catalogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "destination", "confidence"],
      "properties": {
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "destination": {
          "type": ["string", "null"]
        },
        "confidence": {
          "type": "string",
          "enum": ["alta", "baixa"]
        },
        "since": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answer", "scope", "sourceEvidence"],
      "properties": {
        "answer": {
          "type": "object",
          "description": "Resposta estruturada (a forma varia por tipo de pergunta; para pergunta de destino, carrega destinationPath)."
        },
        "contextFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Hash do contexto material que torna a resposta válida; ausência identifica resposta legada não reutilizável."
        },
        "scope": {
          "type": "string",
          "enum": ["this-project", "promote-to-catalog"]
        },
        "sourceEvidence": {
          "type": "string",
          "minLength": 1
        },
        "answeredAt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "shieldEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "selector": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
